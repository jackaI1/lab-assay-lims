{
  "DM": {
    "label": "Demographics",
    "source": "subjects.csv",
    "fields": {
      "STUDYID": {
        "label": "Study identifier",
        "source": "constant SYNTH01",
        "type": "text",
        "required": true,
        "terms": []
      },
      "DOMAIN": {
        "label": "Domain abbreviation",
        "source": "constant DM",
        "type": "text",
        "required": true,
        "terms": []
      },
      "USUBJID": {
        "label": "Unique subject identifier",
        "source": "sid; prepend SYNTH01-",
        "type": "text",
        "required": true,
        "terms": []
      },
      "SUBJID": {
        "label": "Subject identifier",
        "source": "sid",
        "type": "text",
        "required": true,
        "terms": []
      },
      "SITEID": {
        "label": "Study site identifier",
        "source": "constant SYNTH",
        "type": "text",
        "required": true,
        "terms": []
      },
      "AGE": {
        "label": "Age in years",
        "source": "age",
        "type": "integer",
        "required": true,
        "terms": [],
        "minimum": 18,
        "maximum": 90
      },
      "AGEU": {
        "label": "Age unit",
        "source": "constant YEARS",
        "type": "text",
        "required": true,
        "terms": [
          "YEARS"
        ]
      },
      "SEX": {
        "label": "Sex",
        "source": "sex",
        "type": "text",
        "required": true,
        "terms": [
          "M",
          "F",
          "U"
        ]
      },
      "RACE": {
        "label": "Race",
        "source": "race",
        "type": "text",
        "required": true,
        "terms": [
          "WHITE",
          "BLACK OR AFRICAN AMERICAN",
          "ASIAN",
          "NOT REPORTED"
        ]
      },
      "ARMCD": {
        "label": "Planned arm code",
        "source": "arm; A or P",
        "type": "text",
        "required": true,
        "terms": [
          "A",
          "P"
        ]
      },
      "ARM": {
        "label": "Planned arm",
        "source": "arm; A=ACTIVE, P=PLACEBO",
        "type": "text",
        "required": true,
        "terms": [
          "ACTIVE",
          "PLACEBO"
        ]
      },
      "ACTARMCD": {
        "label": "Actual arm code",
        "source": "arm; A or P",
        "type": "text",
        "required": true,
        "terms": [
          "A",
          "P"
        ]
      },
      "ACTARM": {
        "label": "Actual arm",
        "source": "arm; A=ACTIVE, P=PLACEBO",
        "type": "text",
        "required": true,
        "terms": [
          "ACTIVE",
          "PLACEBO"
        ]
      },
      "RFSTDTC": {
        "label": "Reference start date",
        "source": "randomization",
        "type": "date",
        "required": true,
        "terms": []
      },
      "RFENDTC": {
        "label": "Reference end date",
        "source": "death_date if present else last_contact",
        "type": "date",
        "required": true,
        "terms": []
      },
      "RFXSTDTC": {
        "label": "First exposure date",
        "source": "randomization",
        "type": "date",
        "required": true,
        "terms": []
      },
      "RFXENDTC": {
        "label": "Last exposure date",
        "source": "randomization + 27 days",
        "type": "date",
        "required": true,
        "terms": []
      },
      "DTHFL": {
        "label": "Death flag",
        "source": "Y if death_date present else blank",
        "type": "text",
        "required": false,
        "terms": [
          "Y"
        ]
      },
      "DTHDTC": {
        "label": "Death date",
        "source": "death_date",
        "type": "date",
        "required": false,
        "terms": []
      }
    }
  },
