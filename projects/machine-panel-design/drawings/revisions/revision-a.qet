      <element name="02-NOTES-2.elmt">
        <definition type="element" version="0.100" width="1480" height="1140" hotspot_x="20" hotspot_y="20" orientation="dyyy">
          <names>
            <name lang="en">NOTES-2</name>
          </names>
          <informations>Original functional symbol. See data/panel.json and docs/design.md.</informations>
          <description>
            <text x="35" y="38" text="BOTTLE FILLER / 02 / 24 V DC distribution and bonding" size="18" color="black" />
            <text x="35" y="68" text="Revision A | Jack Lai | Simulation / engineering study | 2026-11-05" size="10" color="black" />
            <text x="35" y="850" text="PS1 is fed line-to-line at 208 V (01). 24 V / 2.5 A supply; all field loads included in DC budget." size="10" color="black" />
            <text x="35" y="875" text="F4: 1 A PLC; F3: 2 A control/field; Control conductors: 18 AWG Cu design choice." size="10" color="black" />
            <text x="35" y="900" text="0 V has one intentional bond to PE at the DC distribution terminal; protective earth stays continuous." size="10" color="black" />
            <text x="35" y="925" text="PLC V+ and GND power logic only. Relay output commons are separately wired on 04." size="10" color="black" />
            <text x="35" y="950" text="REV A review: passive cooling at 40 C exceeds the 45 C target. Fan not yet fitted." size="10" color="black" />
            <line x1="35" y1="825" x2="1390" y2="825" end1="none" end2="none" antialias="false" style="line-style:normal;line-weight:normal;filling:none;color:black" />
            <text x="35" y="1025" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal." size="9" color="black" />
          </description>
        </definition>
      </element>
