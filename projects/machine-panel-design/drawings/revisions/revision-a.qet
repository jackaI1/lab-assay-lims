          <description>
            <text x="35" y="38" text="BOTTLE FILLER / 05 / Panel layout, dimensions in mm" size="18" color="black" />
            <text x="35" y="68" text="Revision A | Jack Lai | Simulation / engineering study | 2026-11-05" size="10" color="black" />
            <text x="35" y="850" text="E1: 600 H x 400 W x 200 D steel. Coordinates below are millimetres from backplate upper-left." size="10" color="black" />
            <text x="35" y="875" text="Main power left; 24 V control right. Separate duct routes. DIN rails at y=100, 290, 460 mm." size="10" color="black" />
            <text x="35" y="900" text="Envelopes include conservative planning sizes; verify final vendor drawings and wiring clearances before build." size="10" color="black" />
            <text x="35" y="925" text="PS1: reserve 40 mm above and 20 mm below per mounting guidance." size="10" color="black" />
            <text x="35" y="950" text="Door: S0, S1, S2, S3 and H1, 30 mm envelopes. Bond door to PE. No mains devices on door." size="10" color="black" />
            <text x="35" y="975" text="REV A: initial passive design, retained as a failed thermal review iteration; see Revision B." size="10" color="black" />
            <line x1="35" y1="825" x2="1390" y2="825" end1="none" end2="none" antialias="false" style="line-style:normal;line-weight:normal;filling:none;color:black" />
            <text x="35" y="1025" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal." size="9" color="black" />
            <rect x="100" y="90" width="400" height="600" antialias="false" style="line-style:normal;line-weight:normal;filling:none;color:black" />
            <text x="100" y="720" text="Backplate: 400 W x 600 H; enclosure depth 200" size="11" color="black" />
            <line x1="135" y1="190" x2="470" y2="190" end1="none" end2="none" antialias="false" style="line-style:dashed;line-weight:normal;filling:none;color:black" />
            <line x1="135" y1="380" x2="470" y2="380" end1="none" end2="none" antialias="false" style="line-style:dashed;line-weight:normal;filling:none;color:black" />
            <line x1="135" y1="550" x2="470" y2="550" end1="none" end2="none" antialias="false" style="line-style:dashed;line-weight:normal;filling:none;color:black" />
