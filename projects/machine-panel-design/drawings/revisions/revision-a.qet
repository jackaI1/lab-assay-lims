      <element name="03-NOTES-3.elmt">
        <definition type="element" version="0.100" width="1480" height="1140" hotspot_x="20" hotspot_y="20" orientation="dyyy">
          <names>
            <name lang="en">NOTES-3</name>
          </names>
          <informations>Original functional symbol. See data/panel.json and docs/design.md.</informations>
          <description>
            <text x="35" y="38" text="BOTTLE FILLER / 03 / PLC inputs and field terminal strip" size="18" color="black" />
            <text x="35" y="68" text="Revision A | Jack Lai | Simulation / engineering study | 2026-11-05" size="10" color="black" />
            <text x="35" y="850" text="A1: C0-00DR-D. X1 bottle present; X2 start; X3 stop healthy; X4 enable healthy;" size="10" color="black" />
            <text x="35" y="875" text="X5 overload tripped; X6 contactor feedback; X7 reset; X8 spare (unconnected). C1/C2 to 0 V." size="10" color="black" />
            <text x="35" y="900" text="S0 and S3 use separate NC monitoring poles here. Their hardwired interrupt poles are on 04." size="10" color="black" />
            <text x="35" y="925" text="S4 brown=24CTL, blue=0V, black=PNP signal. X2 terminal strip: numbered internal and field sides." size="10" color="black" />
            <text x="35" y="950" text="Stop and enable are educational interlocks only, not an emergency-stop or safety function." size="10" color="black" />
            <line x1="35" y1="825" x2="1390" y2="825" end1="none" end2="none" antialias="false" style="line-style:normal;line-weight:normal;filling:none;color:black" />
            <text x="35" y="1025" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal." size="9" color="black" />
          </description>
        </definition>
      </element>
