      <element name="01-NOTES-1.elmt">
        <definition type="element" version="0.100" width="1480" height="1140" hotspot_x="20" hotspot_y="20" orientation="dyyy">
          <names>
            <name lang="en">NOTES-1</name>
          </names>
          <informations>Original functional symbol. See data/panel.json and docs/design.md.</informations>
          <description>
            <text x="35" y="38" text="BOTTLE FILLER / 01 / Incoming power and motor starter" size="18" color="black" />
            <text x="35" y="68" text="Revision A | Jack Lai | Simulation / engineering study | 2026-11-05" size="10" color="black" />
            <text x="35" y="850" text="208 V, 3 phase, 60 Hz, grounded-wye only. Assumed available fault: 4 kA rms symmetrical." size="10" color="black" />
            <text x="35" y="875" text="Q0: incoming breaker. Q1: motor short-circuit protection. No selective trip coordination claimed." size="10" color="black" />
            <text x="35" y="900" text="OL1: 1.6-2.5 A range; simulated M1 nameplate 2.0 A; manual reset. Motor loss is outside enclosure." size="10" color="black" />
            <text x="35" y="925" text="Power: 14 AWG Cu design choice. PE: green/yellow, never switched or fused. No neutral required." size="10" color="black" />
            <text x="35" y="950" text="Concept study only. Upstream lockout/isolation, guarding and safety-rated stop need engineered review." size="10" color="black" />
            <line x1="35" y1="825" x2="1390" y2="825" end1="none" end2="none" antialias="false" style="line-style:normal;line-weight:normal;filling:none;color:black" />
            <text x="35" y="1025" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal." size="9" color="black" />
          </description>
        </definition>
      </element>
