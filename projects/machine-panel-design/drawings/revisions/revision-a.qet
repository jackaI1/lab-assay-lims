      <element name="04-NOTES-4.elmt">
        <definition type="element" version="0.100" width="1480" height="1140" hotspot_x="20" hotspot_y="20" orientation="dyyy">
          <names>
            <name lang="en">NOTES-4</name>
          </names>
          <informations>Original functional symbol. See data/panel.json and docs/design.md.</informations>
          <description>
            <text x="35" y="38" text="BOTTLE FILLER / 04 / Hardwired inhibit and PLC relay outputs" size="18" color="black" />
            <text x="35" y="68" text="Revision A | Jack Lai | Simulation / engineering study | 2026-11-05" size="10" color="black" />
            <text x="35" y="850" text="24CTL -&gt; S0 NC -&gt; S3 NC -&gt; OL1 95-96 NC -&gt; A1 C3. Opening any contact removes Y1-Y4 load supply." size="10" color="black" />
            <text x="35" y="875" text="A1 relay group C3 supplies Y1-Y4; C4 (Y5/Y6) unused. Y4/Y5/Y6 are spare and unconnected." size="10" color="black" />
            <text x="35" y="900" text="Y1 energizes K1 coil (A1/A2), Y2 opens YV1, Y3 lights H1. All loads return to 0 V." size="10" color="black" />
            <text x="35" y="925" text="K1 BD has built-in suppression. YV1 diode cathode at +24. X2:11/12 sensor power; X2:13 valve return." size="10" color="black" />
            <text x="35" y="950" text="Start latches a cycle; bottle stops conveyor and starts a 2 s fill. Stop/enable/overload aborts; reset then start." size="10" color="black" />
            <text x="35" y="975" text="No automatic restart. See python3 -m panel simulate for executable timing and fault sequence." size="10" color="black" />
            <line x1="35" y1="825" x2="1390" y2="825" end1="none" end2="none" antialias="false" style="line-style:normal;line-weight:normal;filling:none;color:black" />
            <text x="35" y="1025" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal." size="9" color="black" />
          </description>
        </definition>
      </element>
