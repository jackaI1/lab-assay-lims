            <element name="01-NOTES-1.elmt">
                <definition type="element" hotspot_x="20" hotspot_y="20" orientation="dyyy" width="1480" height="1140" version="0.100">
                    <names>
                        <name lang="en">NOTES-1</name>
                    </names>
                    <informations>Original functional symbol. See data/panel.json and docs/design.md.</informations>
                    <description>
                        <text x="35" y="38" size="18" color="black" text="BOTTLE FILLER / 01 / Incoming power and motor starter"/>
                        <text x="35" y="68" size="10" color="black" text="Revision B | Jack Lai | Simulation / engineering study | 2026-11-05"/>
                        <text x="35" y="850" size="10" color="black" text="208 V, 3 phase, 60 Hz, grounded-wye only. Assumed available fault: 4 kA rms symmetrical."/>
                        <text x="35" y="875" size="10" color="black" text="Q0: incoming breaker. Q1: motor short-circuit protection. No selective trip coordination claimed."/>
                        <text x="35" y="900" size="10" color="black" text="OL1: 1.6-2.5 A range; simulated M1 nameplate 2.0 A; manual reset. Motor loss is outside enclosure."/>
                        <text x="35" y="925" size="10" color="black" text="Power: 14 AWG Cu design choice. PE: green/yellow, never switched or fused. No neutral required."/>
                        <text x="35" y="950" size="10" color="black" text="Concept study only. Upstream lockout/isolation, guarding and safety-rated stop need engineered review."/>
                        <line end1="none" end2="none" y1="825" antialias="false" y2="825" style="line-style:normal;line-weight:normal;filling:none;color:black" x1="35" x2="1390"/>
                        <text x="35" y="1025" size="9" color="black" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal."/>
                    </description>
                </definition>
            </element>
