                    <description>
                        <text x="35" y="38" size="18" color="black" text="BOTTLE FILLER / 05 / Panel layout, dimensions in mm"/>
                        <text x="35" y="68" size="10" color="black" text="Revision B | Jack Lai | Simulation / engineering study | 2026-11-05"/>
                        <text x="35" y="850" size="10" color="black" text="E1: 600 H x 400 W x 200 D steel. Coordinates below are millimetres from backplate upper-left."/>
                        <text x="35" y="875" size="10" color="black" text="Main power left; 24 V control right. Separate duct routes. DIN rails at y=100, 290, 460 mm."/>
                        <text x="35" y="900" size="10" color="black" text="Envelopes include conservative planning sizes; verify final vendor drawings and wiring clearances before build."/>
                        <text x="35" y="925" size="10" color="black" text="PS1: reserve 40 mm above, 20 below per mounting guidance. Keep fan intake and upper outlet clear."/>
                        <text x="35" y="950" size="10" color="black" text="Door: S0, S1, S2, S3 and H1, 30 mm envelopes. Bond door to PE. No mains devices on door."/>
                        <text x="35" y="975" size="10" color="black" text="REV B: added B1 fan, EF1/EF2 outlets and F5 fuse after 40 C ambient check. Redline: drawings/revisions/."/>
                        <line end1="none" end2="none" y1="825" antialias="false" y2="825" style="line-style:normal;line-weight:normal;filling:none;color:black" x1="35" x2="1390"/>
                        <text x="35" y="1025" size="9" color="black" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal."/>
                        <rect x="100" y="90" antialias="false" style="line-style:normal;line-weight:normal;filling:none;color:black" width="400" height="600"/>
                        <text x="100" y="720" size="11" color="black" text="Backplate: 400 W x 600 H; enclosure depth 200"/>
                        <line end1="none" end2="none" y1="190" antialias="false" y2="190" style="line-style:dashed;line-weight:normal;filling:none;color:black" x1="135" x2="470"/>
                        <line end1="none" end2="none" y1="380" antialias="false" y2="380" style="line-style:dashed;line-weight:normal;filling:none;color:black" x1="135" x2="470"/>
