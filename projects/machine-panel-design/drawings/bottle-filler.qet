            <element name="03-NOTES-3.elmt">
                <definition type="element" hotspot_x="20" hotspot_y="20" orientation="dyyy" width="1480" height="1140" version="0.100">
                    <names>
                        <name lang="en">NOTES-3</name>
                    </names>
                    <informations>Original functional symbol. See data/panel.json and docs/design.md.</informations>
                    <description>
                        <text x="35" y="38" size="18" color="black" text="BOTTLE FILLER / 03 / PLC inputs and field terminal strip"/>
                        <text x="35" y="68" size="10" color="black" text="Revision B | Jack Lai | Simulation / engineering study | 2026-11-05"/>
                        <text x="35" y="850" size="10" color="black" text="A1: C0-00DR-D. X1 bottle present; X2 start; X3 stop healthy; X4 enable healthy;"/>
                        <text x="35" y="875" size="10" color="black" text="X5 overload tripped; X6 contactor feedback; X7 reset; X8 spare (unconnected). C1/C2 to 0 V."/>
                        <text x="35" y="900" size="10" color="black" text="S0 and S3 use separate NC monitoring poles here. Their hardwired interrupt poles are on 04."/>
                        <text x="35" y="925" size="10" color="black" text="S4 brown=24CTL, blue=0V, black=PNP signal. X2 terminal strip: numbered internal and field sides."/>
                        <text x="35" y="950" size="10" color="black" text="Stop and enable are educational interlocks only, not an emergency-stop or safety function."/>
                        <line end1="none" end2="none" y1="825" antialias="false" y2="825" style="line-style:normal;line-weight:normal;filling:none;color:black" x1="35" x2="1390"/>
                        <text x="35" y="1025" size="9" color="black" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal."/>
                    </description>
                </definition>
            </element>
