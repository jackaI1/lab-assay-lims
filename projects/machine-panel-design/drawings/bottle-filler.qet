            <element name="02-NOTES-2.elmt">
                <definition type="element" hotspot_x="20" hotspot_y="20" orientation="dyyy" width="1480" height="1140" version="0.100">
                    <names>
                        <name lang="en">NOTES-2</name>
                    </names>
                    <informations>Original functional symbol. See data/panel.json and docs/design.md.</informations>
                    <description>
                        <text x="35" y="38" size="18" color="black" text="BOTTLE FILLER / 02 / 24 V DC distribution and bonding"/>
                        <text x="35" y="68" size="10" color="black" text="Revision B | Jack Lai | Simulation / engineering study | 2026-11-05"/>
                        <text x="35" y="850" size="10" color="black" text="PS1 is fed line-to-line at 208 V (01). 24 V / 2.5 A supply; all field loads included in DC budget."/>
                        <text x="35" y="875" size="10" color="black" text="F4: 1 A PLC; F3: 2 A control/field; F5: 2 A fan. Control conductors: 18 AWG Cu design choice."/>
                        <text x="35" y="900" size="10" color="black" text="0 V has one intentional bond to PE at the DC distribution terminal; protective earth stays continuous."/>
                        <text x="35" y="925" size="10" color="black" text="PLC V+ and GND power logic only. Relay output commons are separately wired on 04."/>
                        <text x="35" y="950" size="10" color="black" text="B1 is continuously supplied. EF1/EF2 outlets give 16 m3/h installed, not 20 free-air."/>
                        <line end1="none" end2="none" y1="825" antialias="false" y2="825" style="line-style:normal;line-weight:normal;filling:none;color:black" x1="35" x2="1390"/>
                        <text x="35" y="1025" size="9" color="black" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal."/>
                    </description>
                </definition>
            </element>
