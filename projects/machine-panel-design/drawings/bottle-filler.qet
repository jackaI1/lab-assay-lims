            <element name="04-NOTES-4.elmt">
                <definition type="element" hotspot_x="20" hotspot_y="20" orientation="dyyy" width="1480" height="1140" version="0.100">
                    <names>
                        <name lang="en">NOTES-4</name>
                    </names>
                    <informations>Original functional symbol. See data/panel.json and docs/design.md.</informations>
                    <description>
                        <text x="35" y="38" size="18" color="black" text="BOTTLE FILLER / 04 / Hardwired inhibit and PLC relay outputs"/>
                        <text x="35" y="68" size="10" color="black" text="Revision B | Jack Lai | Simulation / engineering study | 2026-11-05"/>
                        <text x="35" y="850" size="10" color="black" text="24CTL -> S0 NC -> S3 NC -> OL1 95-96 NC -> A1 C3. Opening any contact removes Y1-Y4 load supply."/>
                        <text x="35" y="875" size="10" color="black" text="A1 relay group C3 supplies Y1-Y4; C4 (Y5/Y6) unused. Y4/Y5/Y6 are spare and unconnected."/>
                        <text x="35" y="900" size="10" color="black" text="Y1 energizes K1 coil (A1/A2), Y2 opens YV1, Y3 lights H1. All loads return to 0 V."/>
                        <text x="35" y="925" size="10" color="black" text="K1 BD has built-in suppression. YV1 diode cathode at +24. X2:11/12 sensor power; X2:13 valve return."/>
                        <text x="35" y="950" size="10" color="black" text="Start latches a cycle; bottle stops conveyor and starts a 2 s fill. Stop/enable/overload aborts; reset then start."/>
                        <text x="35" y="975" size="10" color="black" text="No automatic restart. See python3 -m panel simulate for executable timing and fault sequence."/>
                        <line end1="none" end2="none" y1="825" antialias="false" y2="825" style="line-style:normal;line-weight:normal;filling:none;color:black" x1="35" x2="1390"/>
                        <text x="35" y="1025" size="9" color="black" text="Reference conductors by net name across sheets. Crossings have no junction unless they share a terminal."/>
                    </description>
                </definition>
            </element>
