{
  "name": "clinic-access-api",
  "version": "1.0.0",
  "description": "Clinic records with role permissions, patient isolation and an access-change audit trail",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/test/*.integration.js",
    "demo:seed": "npm run build && node scripts/seed.mjs",
    "local:start": "supabase start -x studio,realtime,storage-api,imgproxy,mailpit,logflare,vector,supavisor,postgres-meta",
    "local:stop": "supabase stop --no-backup",
    "verify": "npm test && node scripts/integration.mjs"
  },
  "author": "Jack Lai",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@supabase/supabase-js": "^2.119.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supabase": "^3.0.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  },
  "private": true
}
